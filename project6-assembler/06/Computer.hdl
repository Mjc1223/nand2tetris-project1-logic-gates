/**
 * The HACK computer, including CPU, ROM and RAM.
 * When reset is 0, the program stored in the computer's ROM executes.
 * When reset is 1, the execution of the program restarts. 
 * Thus, to start a program's execution, reset must be pushed "up" (1)
 * and "down" (0). From this point onward the user is at the mercy of 
 * the software. In particular, depending on the program's code, the 
 * screen may show some output and the user may be able to interact 
 * with the computer via the keyboard.
 */

CHIP Computer {

    IN reset;

    PARTS:
    // Put your code here:
    //ROM with size of 32k, and takes in the input of pc and output the corresponding instruction
    ROM32K(address=pc,out=instruction);


    //CPU represent the current instruction being processed, reset signal to reset cpu, inM data input, outM data output, writeM is control signal for writing data to memory
    // addressM represent the memory address, pc is program counter
    CPU(instruction=instruction,reset=reset, inM=inM, outM=outM, writeM=writeM, addressM=addressM, pc=pc);

    //Memory line
    //outM is the datat input written into memory, load is control signal for loading data into memory
    //address is the memory address
    //out represents the data output read from memory. 
    Memory(in=outM, load=writeM, address=addressM, out=inM);

}
